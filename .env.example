# Copy to sim/.env (loaded automatically) or set in your shell / deploy dashboard.
GROQ_API_KEY=        # https://console.groq.com  — dialogue + narrator (llama-3.3-70b)
MISTRAL_API_KEY=     # https://console.mistral.ai — batched planning + scoring (mistral-small)

# Optional: persist sqlite world state to a path (default in-memory). Memory
# (chroma) is ephemeral either way. Used mainly for a paid deploy with a disk.
# GHOST_DB=/var/data/ghost.sqlite
